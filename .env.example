# --- Database (Vercel Postgres) ---
# Create a Postgres database in the Vercel dashboard for this project.
# Vercel injects POSTGRES_URL automatically once the database is linked.
POSTGRES_URL=

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Stripe ---
# Server-side secret key for the AZ HOUSE BOIS Stripe account.
# Supply via the secure vault flow — never paste raw keys in chat.
STRIPE_SECRET_KEY=
# Webhook signing secret, from the Stripe Dashboard webhook endpoint
# pointing at https://<your-domain>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Stripe subscription prices ($20/month each) ---
# DO NOT fill these in until the correct AZ House Bois Stripe account is
# confirmed and the two $20/month recurring products are created on it.
# Placeholder values keep checkout disabled with a clear message.
STRIPE_PRICE_CLIENT=price_1Udv0xCuX2Dc2d82luX34BmI
STRIPE_PRICE_BOI=price_1Udv0xCuX2Dc2d82PcrJlNLu

# --- App ---
NEXT_PUBLIC_APP_URL=https://az-house-bois.vercel.app
