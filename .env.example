# --- Database (Vercel Postgres) ---
# Create a Postgres database in the Vercel dashboard for this project.
# Vercel injects POSTGRES_URL automatically once the database is linked.
POSTGRES_URL=

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Stripe ---
# Server-side secret key for the AZ HOUSE BOIS Stripe account.
# Supply via the secure vault flow — never paste raw keys in chat.
STRIPE_SECRET_KEY=
# Webhook signing secret, from the Stripe Dashboard webhook endpoint
# pointing at https://<your-domain>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Stripe subscription prices ($20/month each) ---
# DO NOT fill these in until the correct AZ House Bois Stripe account is
# confirmed and the two $20/month recurring products are created on it.
# Placeholder values keep checkout disabled with a clear message.
STRIPE_PRICE_CLIENT=price_1Udv0xCuX2Dc2d82luX34BmI
STRIPE_PRICE_BOI=price_1Udv0xCuX2Dc2d82PcrJlNLu

# --- PayPal (second payment option, alongside Stripe) ---
# REST API app credentials from developer.paypal.com (My Apps &
# Credentials). Supply via the secure vault flow — never paste raw keys
# in chat. Leave these empty and the site works exactly as before —
# the PayPal buttons hide themselves with a plain "not set up yet" note.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" for real payments, anything else (or unset) is the sandbox.
PAYPAL_MODE=sandbox
# $20/month billing plans, created in the PayPal Business dashboard
# (Subscriptions → Create plan, $20 USD monthly, no trial — the
# founding free month is applied per subscription, not on the plan).
# Placeholder values keep PayPal subscriptions disabled with a clear
# message until real plan IDs are set.
PAYPAL_PLAN_CLIENT=plan_CLIENT_PLACEHOLDER
PAYPAL_PLAN_BOI=plan_BOI_PLACEHOLDER
# Webhook ID from the webhook endpoint in the developer dashboard
# pointing at https://<your-domain>/api/webhooks/paypal (optional —
# without it the webhook verifies events by fetching from PayPal).
PAYPAL_WEBHOOK_ID=
# Public client ID for the PayPal JS SDK buttons. Same value as
# PAYPAL_CLIENT_ID; falls back to it automatically when unset.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=https://az-house-bois.vercel.app

# --- Admin ---
# Email allowed to review cleaner applications at /admin/applications
# (approve/deny, sees SSNs for 1099 filing). Defaults to this address.
ADMIN_EMAIL=stevendrice2992@gmail.com

# --- Admin email notifications (Resend) ---
# Free Resend account on stevendrice2992@gmail.com. Steven gets emailed
# when someone signs up or a cleaner applies. Leave RESEND_API_KEY empty
# and the app works exactly as before — notifications just don't send.
RESEND_API_KEY=
# Who gets the notification emails. Defaults to stevendrice2992@gmail.com.
NOTIFY_EMAIL=stevendrice2992@gmail.com
